{
    "name": "easypixels/sdk-php-laravel",
    "description": "Laravel integration for the EasyPixel PHP SDK",
    "type": "library",
    "license": "MIT",
    "keywords": ["easypixel", "laravel", "led", "matrix", "pixel", "api", "sdk", "webhook"],
    "homepage": "https://github.com/easypixels/sdk-php-laravel",
    "repositories": [
        {
            "type": "path",
            "url": "../sdk-php",
            "options": {
                "versions": {
                    "easypixels/sdk-php": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "easypixels/sdk-php": "^1.0",
        "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/contracts": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/queue": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^9.5 || ^10.1 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EasyPixel\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasyPixel\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EasyPixel\\Laravel\\EasyPixelServiceProvider"
            ],
            "aliases": {
                "EasyPixel": "EasyPixel\\Laravel\\Facades\\EasyPixel"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
